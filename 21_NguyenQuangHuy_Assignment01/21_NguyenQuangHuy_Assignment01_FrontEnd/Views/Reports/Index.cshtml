@model _21_NguyenQuangHuy_Assignment01_FrontEnd.Models.ReportVM
@{
    ViewData["Title"] = "News Report & Statistics";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="fw-bold mb-0"><i class="bi bi-graph-up-arrow text-primary me-2"></i>News Report & Statistics</h2>
        <p class="text-muted small mb-0">Generate statistics on articles created within a specified date period</p>
    </div>
</div>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-4">
        <form asp-action="Index" method="get" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label asp-for="StartDate" class="form-label fw-semibold"></label>
                <input asp-for="StartDate" class="form-control" type="date" />
                <span asp-validation-for="StartDate" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="EndDate" class="form-label fw-semibold"></label>
                <input asp-for="EndDate" class="form-control" type="date" />
                <span asp-validation-for="EndDate" class="text-danger small"></span>
            </div>
            <div class="col-md-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1">
                    <i class="bi bi-bar-chart-fill me-1"></i> Generate Report
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Summary Cards -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-lg-3">
        <div class="card shadow-sm border-0 border-start border-4 border-primary h-100">
            <div class="card-body">
                <div class="text-muted small fw-semibold">TOTAL ARTICLES</div>
                <div class="fs-2 fw-bold text-dark mt-1">@Model.TotalNews</div>
                <div class="small text-muted mt-1"><i class="bi bi-journal-text me-1"></i>In selected period</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card shadow-sm border-0 border-start border-4 border-success h-100">
            <div class="card-body">
                <div class="text-muted small fw-semibold">ACTIVE ARTICLES</div>
                <div class="fs-2 fw-bold text-success mt-1">@Model.ActiveCount</div>
                <div class="small text-muted mt-1"><i class="bi bi-check-circle me-1"></i>Publicly visible</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card shadow-sm border-0 border-start border-4 border-warning h-100">
            <div class="card-body">
                <div class="text-muted small fw-semibold">INACTIVE ARTICLES</div>
                <div class="fs-2 fw-bold text-warning mt-1">@Model.InactiveCount</div>
                <div class="small text-muted mt-1"><i class="bi bi-pause-circle me-1"></i>Draft / hidden</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card shadow-sm border-0 border-start border-4 border-info h-100">
            <div class="card-body">
                <div class="text-muted small fw-semibold">CATEGORIES USED</div>
                <div class="fs-2 fw-bold text-info mt-1">@Model.ByCategory.Count</div>
                <div class="small text-muted mt-1"><i class="bi bi-tags me-1"></i>Different topics</div>
            </div>
        </div>
    </div>
</div>

<!-- Summaries By Category & By Author -->
<div class="row g-4 mb-4">
    <div class="col-lg-6">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white py-3">
                <h5 class="card-title fw-bold mb-0"><i class="bi bi-pie-chart-fill text-primary me-2"></i>Articles by Category</h5>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Category</th>
                            <th class="text-end" style="width: 120px;">Article Count</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.ByCategory.Count == 0)
                        {
                            <tr><td colspan="2" class="text-center text-muted py-3">No data available</td></tr>
                        }
                        else
                        {
                            @foreach (var c in Model.ByCategory)
                            {
                                <tr>
                                    <td class="fw-semibold">@c.Name</td>
                                    <td class="text-end"><span class="badge bg-primary fs-6">@c.Count</span></td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white py-3">
                <h5 class="card-title fw-bold mb-0"><i class="bi bi-person-lines-fill text-success me-2"></i>Articles by Author</h5>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Author</th>
                            <th class="text-end" style="width: 120px;">Article Count</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.ByAuthor.Count == 0)
                        {
                            <tr><td colspan="2" class="text-center text-muted py-3">No data available</td></tr>
                        }
                        else
                        {
                            @foreach (var a in Model.ByAuthor)
                            {
                                <tr>
                                    <td class="fw-semibold">@a.Name</td>
                                    <td class="text-end"><span class="badge bg-success fs-6">@a.Count</span></td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Detailed Articles Table (Sorted DESC by CreatedDate) -->
<div class="card shadow-sm border-0">
    <div class="card-header bg-white py-3">
        <h5 class="card-title fw-bold mb-0"><i class="bi bi-table text-secondary me-2"></i>Articles in Period (Sorted Descending)</h5>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width: 70px;">ID</th>
                    <th>Title & Headline</th>
                    <th>Category</th>
                    <th>Author</th>
                    <th>Created Date</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Articles.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted">
                            <i class="bi bi-calendar-x fs-3 d-block mb-1"></i>
                            No articles found in this date range.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model.Articles)
                    {
                        <tr>
                            <td class="fw-semibold">@item.NewsArticleId</td>
                            <td>
                                <div class="fw-bold">@item.NewsTitle</div>
                                <div class="text-muted small text-truncate" style="max-width: 380px;">@item.Headline</div>
                            </td>
                            <td>
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                                    @(item.CategoryName ?? "N/A")
                                </span>
                            </td>
                            <td class="small">
                                <i class="bi bi-person text-muted me-1"></i>@(item.CreatedByName ?? "N/A")
                            </td>
                            <td class="small fw-semibold text-muted">
                                @(item.CreatedDate?.ToString("yyyy-MM-dd HH:mm") ?? "N/A")
                            </td>
                            <td>
                                @if (item.NewsStatus)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">Inactive</span>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
