@model _21_NguyenQuangHuy_Assignment01_FrontEnd.Models.NewsArticleVM
@{
    bool isEdit = !string.IsNullOrEmpty(Model.NewsArticleId);
    var categories = ViewBag.Categories as List<_21_NguyenQuangHuy_Assignment01_FrontEnd.Models.CategoryVM> ?? new();
    var tags = ViewBag.Tags as List<_21_NguyenQuangHuy_Assignment01_FrontEnd.Models.TagVM> ?? new();
}

<div class="modal-header">
    <h5 class="modal-title fw-bold" id="appModalTitle">
        <i class="bi @(isEdit ? "bi-pencil-square text-warning" : "bi-file-earmark-plus text-primary") me-2"></i>
        @(isEdit ? "Edit News Article" : "Create New News Article")
    </h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<form asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@(isEdit ? Model.NewsArticleId : null)" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="NewsArticleId" />

    <div class="modal-body p-4">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

        <div class="row g-3">
            <div class="col-12">
                <label asp-for="NewsTitle" class="form-label fw-semibold"></label>
                <input asp-for="NewsTitle" class="form-control" placeholder="Enter article headline or title" />
                <span asp-validation-for="NewsTitle" class="text-danger small"></span>
            </div>

            <div class="col-12">
                <label asp-for="Headline" class="form-label fw-semibold"></label>
                <input asp-for="Headline" class="form-control" placeholder="Enter short summary or headline" />
                <span asp-validation-for="Headline" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="CategoryId" class="form-label fw-semibold"></label>
                <select asp-for="CategoryId" class="form-select">
                    <option value="">-- Select Active Category --</option>
                    @foreach (var c in categories)
                    {
                        <option value="@c.CategoryId">@c.CategoryName</option>
                    }
                </select>
                <span asp-validation-for="CategoryId" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="NewsSource" class="form-label fw-semibold"></label>
                <input asp-for="NewsSource" class="form-control" placeholder="e.g. FPT University, Reuters" />
                <span asp-validation-for="NewsSource" class="text-danger small"></span>
            </div>

            <div class="col-12">
                <label class="form-label fw-semibold">Tags (Select all that apply)</label>
                <div class="border rounded p-2 bg-light d-flex flex-wrap gap-2" style="max-height: 120px; overflow-y: auto;">
                    @foreach (var t in tags)
                    {
                        <div class="form-check form-check-inline m-0">
                            <input class="form-check-input" type="checkbox" name="TagIds" value="@t.TagId" id="tag_@t.TagId"
                                   checked="@(Model.TagIds != null && Model.TagIds.Contains(t.TagId))" />
                            <label class="form-check-label small" for="tag_@t.TagId">@t.TagName</label>
                        </div>
                    }
                </div>
            </div>

            <div class="col-12">
                <label asp-for="NewsContent" class="form-label fw-semibold"></label>
                <textarea asp-for="NewsContent" class="form-control" rows="6" placeholder="Write the full content of the news article..."></textarea>
                <span asp-validation-for="NewsContent" class="text-danger small"></span>
            </div>

            <div class="col-12">
                <div class="form-check form-switch">
                    <input asp-for="NewsStatus" class="form-check-input" type="checkbox" id="newsStatusSwitch" />
                    <label class="form-check-label fw-semibold" for="newsStatusSwitch">Publish (Active)</label>
                    <div class="form-text small">Only active articles are visible on the public news page.</div>
                </div>
            </div>
        </div>
    </div>

    <div class="modal-footer bg-light">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-save me-1"></i> Save Changes
        </button>
    </div>
</form>
