@model List<_21_NguyenQuangHuy_Assignment01_FrontEnd.Models.NewsArticleVM>
@{
    ViewData["Title"] = "News Articles Management";
    string currentSearch = ViewBag.CurrentSearch ?? "";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="fw-bold mb-0"><i class="bi bi-journal-text text-primary me-2"></i>News Articles Management</h2>
        <p class="text-muted small mb-0">Create, update, search, and manage all news articles</p>
    </div>
    <div>
        <button class="btn btn-primary" data-modal-url="@Url.Action("Create")">
            <i class="bi bi-file-earmark-plus me-1"></i> Create Article
        </button>
    </div>
</div>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-3">
        <form asp-action="Index" method="get" class="row g-2">
            <div class="col-md-6 col-lg-5">
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="search" value="@currentSearch" class="form-control" placeholder="Search by title or headline..." />
                    <button type="submit" class="btn btn-primary">Search</button>
                    @if (!string.IsNullOrWhiteSpace(currentSearch))
                    {
                        <a asp-action="Index" class="btn btn-outline-secondary" title="Clear search"><i class="bi bi-x-lg"></i></a>
                    }
                </div>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width: 70px;">ID</th>
                    <th style="min-width: 250px;">Title & Headline</th>
                    <th>Category</th>
                    <th>Tags</th>
                    <th>Status</th>
                    <th>Created By</th>
                    <th>Created Date</th>
                    <th class="text-end" style="width: 170px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || Model.Count == 0)
                {
                    <tr>
                        <td colspan="8" class="text-center py-4 text-muted">
                            <i class="bi bi-inbox fs-3 d-block mb-1"></i>
                            No news articles found.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@item.NewsArticleId</td>
                            <td>
                                <div class="fw-bold text-dark">@item.NewsTitle</div>
                                <div class="text-muted small text-truncate" style="max-width: 320px;">@item.Headline</div>
                            </td>
                            <td>
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                                    @(item.Category?.CategoryName ?? item.CategoryName ?? "N/A")
                                </span>
                            </td>
                            <td>
                                @if (item.Tags != null && item.Tags.Count > 0)
                                {
                                    <div class="d-flex flex-wrap gap-1">
                                        @foreach (var t in item.Tags)
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary small">#@t.TagName</span>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted small">-</span>
                                }
                            </td>
                            <td>
                                @if (item.NewsStatus)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">Inactive</span>
                                }
                            </td>
                            <td class="small">
                                <i class="bi bi-person text-muted me-1"></i>@(item.CreatedBy?.AccountName ?? item.CreatedByName ?? "N/A")
                            </td>
                            <td class="small text-muted">
                                @(item.CreatedDate?.ToString("yyyy-MM-dd HH:mm") ?? "N/A")
                            </td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-primary me-1" data-modal-url="@Url.Action("Edit", new { id = item.NewsArticleId })" title="Edit">
                                    <i class="bi bi-pencil-square"></i> Edit
                                </button>
                                <button class="btn btn-sm btn-outline-danger" data-delete-url="@Url.Action("Delete", new { id = item.NewsArticleId })" data-delete-name="@item.NewsTitle" title="Delete">
                                    <i class="bi bi-trash"></i> Delete
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
