@model List<_21_NguyenQuangHuy_Assignment01_FrontEnd.Models.AccountVM>
@{
    ViewData["Title"] = "Account Management";
    string currentSearch = ViewBag.CurrentSearch ?? "";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="fw-bold mb-0"><i class="bi bi-people-fill text-primary me-2"></i>Account Management</h2>
        <p class="text-muted small mb-0">Manage system users (Staff & Lecturers)</p>
    </div>
    <div>
        <button class="btn btn-primary" data-modal-url="@Url.Action("Create")">
            <i class="bi bi-person-plus-fill me-1"></i> Create Account
        </button>
    </div>
</div>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-3">
        <form asp-action="Index" method="get" class="row g-2">
            <div class="col-md-6 col-lg-5">
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="search" value="@currentSearch" class="form-control" placeholder="Search by name or email..." />
                    <button type="submit" class="btn btn-primary">Search</button>
                    @if (!string.IsNullOrWhiteSpace(currentSearch))
                    {
                        <a asp-action="Index" class="btn btn-outline-secondary" title="Clear search"><i class="bi bi-x-lg"></i></a>
                    }
                </div>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width: 80px;">ID</th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th class="text-end" style="width: 180px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || Model.Count == 0)
                {
                    <tr>
                        <td colspan="5" class="text-center py-4 text-muted">
                            <i class="bi bi-inbox fs-3 d-block mb-1"></i>
                            No accounts found.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@item.AccountId</td>
                            <td class="fw-semibold">@item.AccountName</td>
                            <td>@item.AccountEmail</td>
                            <td>
                                @if (item.AccountRole == 1)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle"><i class="bi bi-shield-check me-1"></i>Staff</span>
                                }
                                else if (item.AccountRole == 2)
                                {
                                    <span class="badge bg-info-subtle text-info border border-info-subtle"><i class="bi bi-book me-1"></i>Lecturer</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Unknown</span>
                                }
                            </td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-primary me-1" data-modal-url="@Url.Action("Edit", new { id = item.AccountId })" title="Edit">
                                    <i class="bi bi-pencil-square"></i> Edit
                                </button>
                                <button class="btn btn-sm btn-outline-danger" data-delete-url="@Url.Action("Delete", new { id = item.AccountId })" data-delete-name="@item.AccountName (@item.AccountEmail)" title="Delete">
                                    <i class="bi bi-trash"></i> Delete
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
